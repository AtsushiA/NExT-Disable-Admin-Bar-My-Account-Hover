{
  "name": "next-season/next-disable-adminbar-hover",
  "description": "アドミンバーのトップセカンダリメニューのマウスオーバー機能を無効化するWordPressプラグイン",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {},
  "require-dev": {
    "squizlabs/php_codesniffer": "^3",
    "wp-coding-standards/wpcs": "^3",
    "phpcompatibility/phpcompatibility-wp": "*",
    "dealerdirect/phpcodesniffer-composer-installer": "^1",
    "yoast/wp-test-utils": "^1",
    "doctrine/instantiator": ">=1.5.0 <2.1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "NextDisableAdminbarHover\\Tests\\": "tests/phpunit/"
    }
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
